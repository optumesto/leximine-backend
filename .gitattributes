# Normalise line endings in the repository, check out native on each machine.
* text=auto

# A .cmd with LF endings fails in ways that look nothing like a line-ending
# problem: the shell reads the trailing CR as part of the command.
*.cmd    text eol=crlf
*.bat    text eol=crlf
*.ps1    text eol=crlf
*.sh     text eol=lf

# Binary: never normalised, never diffed as text.
*.png    binary
*.ico    binary
*.wav    binary
*.db     binary
