# Copy to .env and edit. run.ps1 loads it if present.
#
# Keys are LEXIMINE_*. Up to 2026-11-05 this project was called "lingua-stt"
# and the prefix was LEXIMINE_*; an .env written then still works -- every
# setting is looked up under the new prefix first and the old one second.

# --- server ---------------------------------------------------------------
LEXIMINE_HOST=127.0.0.1
LEXIMINE_PORT=8760
LEXIMINE_LOG_LEVEL=INFO

# --- whisper --------------------------------------------------------------
# tiny | base | small | medium | large-v3
#
# Leave this on `small`. `medium` was measured and is *worse* here -- 87.1%
# against small's 90.5% -- because a stronger language prior is more willing
# to turn a lone word into confident English ("Cubo" came back as "Google.").
# It is also 143 ms a pass against 61 ms, which the speculative-pass loop
# cannot afford. See "Recognition accuracy, measured" in README.md.
LEXIMINE_MODEL=small
LEXIMINE_DEVICE=cuda
# float32 produced byte-identical output at 50% more latency; int8_float16
# was inside the noise and slower. float16 it is.
LEXIMINE_COMPUTE_TYPE=float16
# 5, not 1: about six points of exact transcription for three milliseconds.
LEXIMINE_BEAM_SIZE=5
# Where model weights are cached (a few hundred MB to ~3 GB for large-v3)
LEXIMINE_MODEL_DIR=./models

# --- language -------------------------------------------------------------
# Must match a file in ./lang -- run scripts/extract_lang.py to create one.
LEXIMINE_TARGET_LANG=es_es
LEXIMINE_LANG_DIR=./lang
# Decode language, derived from the above if left empty (es_es -> es)
LEXIMINE_WHISPER_LANG=

# --- difficulty -----------------------------------------------------------
# Overall similarity needed to accept, 0-100
LEXIMINE_MATCH_THRESHOLD=80
# Minimum score for each distinguishing word of a multi-word name. This is
# what keeps "lingote de oro" from being accepted as "Lingote de hierro".
LEXIMINE_TOKEN_GATE=70
# Ignore accents when comparing (recommended: whisper is inconsistent on them)
LEXIMINE_STRIP_ACCENTS=true
LEXIMINE_STRIP_ARTICLES=true
# Easy mode: feed the expected word to the decoder as a hotword. Makes whisper
# much more likely to "hear" the right answer, including when you mumble, so
# it mostly defeats the point. Off by default.
LEXIMINE_EASY_MODE=false

# --- timing ---------------------------------------------------------------
LEXIMINE_DEFAULT_TIMEOUT_MS=6000
# Run a speculative pass this often so a correct answer resolves immediately
LEXIMINE_PARTIAL_INTERVAL_MS=350
LEXIMINE_MIN_AUDIO_MS=400
LEXIMINE_MAX_AUDIO_MS=30000
# One final pass when the clock hits zero instead of an instant fail
LEXIMINE_TIMEOUT_GRACE=true

# --- speech gating --------------------------------------------------------
# RMS below which the buffer is treated as silence and never reaches whisper.
# Raise if a noisy room produces phantom transcripts; lower if a quiet mic
# gets ignored. scripts/test_client.py prints the measured rms in `debug`.
LEXIMINE_SILENCE_RMS=0.0045
LEXIMINE_NO_SPEECH_MAX=0.85
LEXIMINE_AVG_LOGPROB_MIN=-1.25
# Measured as making no difference either way. Left on because it is the
# cheapest guard against whisper inventing words out of room noise.
LEXIMINE_VAD=true

# --- things that were measured and rejected -------------------------------
# All three are off because the numbers said so, not because nobody tried
# them. Re-measure with scripts/benchmark_asr.py before turning one on.
#
# A sentence of context in the target language, prepended to every decode.
# No gain on the pass rate and ten points off exact transcription.
LEXIMINE_CONTEXT_PROMPT=false
# Bring a quiet take up to a target level before decoding. Worse: it
# amplifies the room with the voice.
LEXIMINE_NORMALISE_INPUT=false
# Retry a poor decode at rising temperatures. No measurable gain.
LEXIMINE_TEMPERATURE_FALLBACK=false

# --- pronunciation leniency -----------------------------------------------
# Spanish /p t k/ are unaspirated, which an English-trained decoder hears as
# /b d g/ -- "Pan" comes back as "Ban", "BEN", "Pen". Merging those pairs
# gains about two points on four of six test voices and costs nothing
# measured on the confusable-pairs corpus, because the Minecraft item
# vocabulary has almost no p/b or t/d minimal pairs. Set to 0 for strict.
LEXIMINE_LENIENT_STOPS=1

# --- the sentence judge (villagers, and the nether portal) ----------------
# Only these two features use it, and both let you straight through when no
# model is reachable -- so this whole section is optional. Needs Ollama
# (https://ollama.com) and `ollama pull <the model below>`.
#
# gemma3:12b holds about 8 GB of VRAM, measured. A smaller model such as
# gemma3:4b will fit a smaller card, but has not been tested here -- the
# prompt asks for a grammar judgement and a one-line reason, and how well a
# 4B model holds that line is an open question rather than a recommendation.
LEXIMINE_LLM_MODEL=gemma3:12b
# A cold model is 30.8 s against a 12 s trade timeout, so residency is a
# correctness concern. The judge is warmed when a client connects and
# re-checked on this interval while someone is playing.
LEXIMINE_LLM_KEEP_ALIVE=2h
LEXIMINE_LLM_WARM_INTERVAL=600
